# ─────────────────────────────────────────────────────────────────────────────
# essor : variables d'environnement du formulaire « Démarrer un projet » (/contact)
#
# En local : copiez ce fichier en .env.local et remplissez les valeurs.
# En production : ajoutez-les dans Vercel > Settings > Environment Variables,
# puis redéployez. Guide pas à pas : docs/FORMULAIRE.md
#
# Chaque brief part sur DEUX canaux en parallèle : un e-mail (Resend) et une ligne
# dans un Google Sheet. Il suffit qu'un des deux fonctionne pour que l'envoi réussisse.
# Sans aucun canal configuré : en local, le brief s'affiche dans le terminal ;
# en production, le visiteur voit un message d'erreur (rien n'est perdu en silence).
# ─────────────────────────────────────────────────────────────────────────────

# Adresse publique du site, utilisée dans les e-mails (lien vers la page /contact).
# Sur Vercel, l'adresse de production est détectée automatiquement si vous la laissez vide.
NEXT_PUBLIC_SITE_URL=

# ── E-mail (Resend) ──────────────────────────────────────────────────────────

# Clé API Resend (resend.com > API Keys), commence par « re_ ». Gardez-la secrète.
RESEND_API_KEY=

# Qui reçoit les briefs. Plusieurs adresses possibles, séparées par des virgules.
# Tant que votre domaine n'est pas vérifié sur Resend, seule l'adresse du compte Resend
# peut recevoir des e-mails.
BRIEF_TO_EMAIL=

# Expéditeur des e-mails. Par défaut : essor <onboarding@resend.dev> (adresse de test de Resend).
# Une fois votre domaine vérifié sur Resend, mettez par exemple : essor <brief@votre-domaine.com>
BRIEF_FROM_EMAIL=

# "true" pour envoyer aussi un accusé de réception au client.
# Nécessite un domaine vérifié sur Resend et BRIEF_FROM_EMAIL sur ce domaine.
BRIEF_SEND_CONFIRMATION=false

# Fuseau horaire de la date affichée dans l'e-mail (nom IANA). Par défaut : Europe/Paris.
# Exemples : Africa/Algiers, Africa/Casablanca, Africa/Tunis, Europe/Paris
BRIEF_TIMEZONE=

# ── Google Sheets (Apps Script) ──────────────────────────────────────────────

# URL de l'application Web Apps Script (Déployer > Nouveau déploiement), se termine par /exec.
GOOGLE_SHEETS_WEBHOOK_URL=

# Secret partagé : la même valeur que la propriété de script SECRET dans Apps Script.
# Une longue chaîne aléatoire, par exemple générée avec : openssl rand -hex 32
GOOGLE_SHEETS_SECRET=
